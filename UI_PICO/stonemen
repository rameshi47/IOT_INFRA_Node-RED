[
    {
        "id": "inject_trigger",
        "type": "inject",
        "name": "Every 30s",
        "props": [{ "p": "payload" }],
        "repeat": "30",
        "once": true,
        "onceDelay": 1,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 120,
        "y": 100,
        "wires": [["fn_device_list"]]
    },
    {
        "id": "fn_device_list",
        "type": "function",
        "name": "Device List",
        "func": "// ============================================\n// DEVICE LIST — Add all your 52 devices here\n// type 'out' = Node-RED connects TO device\n// type 'in'  = Device connects TO Node-RED\n// ============================================\n\nmsg.payload = [\n\n    // --- PRINTERS (port 9100) ---\n    { name: 'Printer_01', ip: '192.168.1.10', port: 9100, type: 'out', group: 'Printer' },\n    { name: 'Printer_02', ip: '192.168.1.11', port: 9100, type: 'out', group: 'Printer' },\n    { name: 'Printer_03', ip: '192.168.1.12', port: 9100, type: 'out', group: 'Printer' },\n\n    // --- BARCODE SCANNERS (port 5000) ---\n    // type 'in' = scanner pushes data to Node-RED, skip ping\n    { name: 'Scanner_01', ip: '192.168.1.20', port: 5000, type: 'in', group: 'Scanner' },\n    { name: 'Scanner_02', ip: '192.168.1.21', port: 5000, type: 'in', group: 'Scanner' },\n    { name: 'Scanner_03', ip: '192.168.1.22', port: 5000, type: 'in', group: 'Scanner' },\n\n    // --- RASPBERRY PI (port 22 = SSH) ---\n    { name: 'RPi_01', ip: '192.168.1.30', port: 22, type: 'out', group: 'RPi' },\n    { name: 'RPi_02', ip: '192.168.1.31', port: 22, type: 'out', group: 'RPi' },\n\n    // --- PLC (port 102 = Modbus/S7) ---\n    { name: 'PLC_01', ip: '192.168.1.40', port: 102, type: 'out', group: 'PLC' },\n    { name: 'PLC_02', ip: '192.168.1.41', port: 102, type: 'out', group: 'PLC' }\n\n    // Add remaining devices following same pattern...\n];\n\nreturn msg;",
        "outputs": 1,
        "x": 300,
        "y": 100,
        "wires": [["split_devices"]]
    },
    {
        "id": "split_devices",
        "type": "split",
        "name": "Split Devices",
        "splt": "\\n",
        "spltType": "str",
        "arraySplt": 1,
        "arraySpltType": "len",
        "stream": false,
        "x": 480,
        "y": 100,
        "wires": [["fn_prep_ping"]]
    },
    {
        "id": "fn_prep_ping",
        "type": "function",
        "name": "Prep TCP Ping",
        "func": "// ============================================\n// PREP — Build nc ping command per device\n// Skips scanners (type 'in') — they call us\n// ============================================\n\nconst device = msg.payload;\nmsg._device = device;\n\nif (device.type === 'out') {\n    // nc -z = connect only, no data\n    // -w 2  = 2 second timeout\n    msg.payload = `nc -z -w 2 ${device.ip} ${device.port}`;\n} else {\n    // Scanner — mark as listener, no ping\n    msg.payload = null;\n}\n\nreturn msg;",
        "outputs": 1,
        "x": 660,
        "y": 100,
        "wires": [["switch_device_type"]]
    },
    {
        "id": "switch_device_type",
        "type": "switch",
        "name": "Route by Type",
        "property": "payload",
        "propertyType": "msg",
        "rules": [
            { "t": "null" },
            { "t": "else" }
        ],
        "checkall": "true",
        "repair": false,
        "outputs": 2,
        "x": 860,
        "y": 100,
        "wires": [
            ["fn_scanner_status"],
            ["exec_nc_ping"]
        ]
    },
    {
        "id": "fn_scanner_status",
        "type": "function",
        "name": "Mark Scanner as Listener",
        "func": "// ============================================\n// SCANNER — No ping, mark as LISTENER\n// Actual connect state tracked via tcp in node\n// ============================================\n\nconst device = msg._device;\nconst now = new Date().toLocaleTimeString();\n\nmsg.payload = {\n    name:      device.name,\n    ip:        device.ip,\n    port:      device.port,\n    group:     device.group,\n    status:    'LISTENER',\n    color:     'blue',\n    timestamp: now\n};\n\nmsg.topic = `devices/status/${device.group}/${device.name}`;\n\nreturn msg;",
        "outputs": 1,
        "x": 1060,
        "y": 40,
        "wires": [["join_results"]]
    },
    {
        "id": "exec_nc_ping",
        "type": "exec",
        "name": "nc Ping",
        "command": "",
        "addpay": true,
        "append": "",
        "useSpawn": false,
        "timer": "4",
        "winHide": false,
        "x": 1060,
        "y": 160,
        "wires": [
            [],
            [],
            ["fn_parse_result"]
        ]
    },
    {
        "id": "fn_parse_result",
        "type": "function",
        "name": "Parse UP / DOWN",
        "func": "// ============================================\n// PARSE RESULT — exec 3rd output = return code\n// 0 = TCP connected = UP\n// 1 = failed/timeout = DOWN\n// ============================================\n\nconst device  = msg._device;\nconst retCode = msg.payload;  // 0 or 1\nconst isUp    = (retCode === 0);\nconst now     = new Date().toLocaleTimeString();\n\nmsg.payload = {\n    name:      device.name,\n    ip:        device.ip,\n    port:      device.port,\n    group:     device.group,\n    status:    isUp ? 'UP'    : 'DOWN',\n    color:     isUp ? 'green' : 'red',\n    timestamp: now\n};\n\nmsg.topic = `devices/status/${device.group}/${device.name}`;\n\nreturn msg;",
        "outputs": 1,
        "x": 1260,
        "y": 160,
        "wires": [["join_results"]]
    },
    {
        "id": "join_results",
        "type": "join",
        "name": "Join All Results",
        "mode": "custom",
        "build": "array",
        "property": "payload",
        "propertyType": "msg",
        "key": "topic",
        "joiner": "\\n",
        "joinerType": "str",
        "accumulate": false,
        "timeout": "35",
        "count": "10",
        "reduceRight": false,
        "x": 1460,
        "y": 100,
        "wires": [["fn_dashboard_table", "mqtt_status_all"]]
    },
    {
        "id": "fn_dashboard_table",
        "type": "function",
        "name": "Build Dashboard Table",
        "func": "// ============================================\n// DASHBOARD — Format results for ui_table\n// DOWN devices sorted to top\n// ============================================\n\nconst results = msg.payload;\n\n// Sort: DOWN first, then by group name\nresults.sort((a, b) => {\n    if (a.status === 'DOWN' && b.status !== 'DOWN') return -1;\n    if (a.status !== 'DOWN' && b.status === 'DOWN') return  1;\n    return a.group.localeCompare(b.group);\n});\n\n// Summary counts\nconst total    = results.length;\nconst up       = results.filter(d => d.status === 'UP').length;\nconst down     = results.filter(d => d.status === 'DOWN').length;\nconst listener = results.filter(d => d.status === 'LISTENER').length;\n\n// Send table data\nmsg.payload = results;\n\n// Send summary string to a separate ui_text node\nflow.set('device_summary', `UP: ${up}  DOWN: ${down}  LISTENERS: ${listener}  TOTAL: ${total}`);\n\nreturn msg;",
        "outputs": 1,
        "x": 1680,
        "y": 60,
        "wires": [["ui_table_status"]]
    },
    {
        "id": "mqtt_status_all",
        "type": "mqtt out",
        "name": "MQTT All Status",
        "topic": "",
        "qos": "1",
        "retain": "false",
        "broker": "mqtt_broker",
        "x": 1680,
        "y": 140,
        "wires": []
    },
    {
        "id": "ui_table_status",
        "type": "ui_table",
        "group": "ui_group_status",
        "name": "Device Status Table",
        "label": "Device Status",
        "order": 1,
        "width": "12",
        "height": "8",
        "columns": [
            { "field": "name",      "label": "Device",    "type": "text" },
            { "field": "ip",        "label": "IP",        "type": "text" },
            { "field": "group",     "label": "Group",     "type": "text" },
            { "field": "status",    "label": "Status",    "type": "text" },
            { "field": "timestamp", "label": "Last Check","type": "text" }
        ],
        "x": 1900,
        "y": 60,
        "wires": [[]]
    },
    {
        "id": "tcp_in_scanners",
        "type": "tcp in",
        "name": "Scanner TCP IN (port 5000)",
        "server": "server",
        "host": "",
        "port": "5000",
        "datamode": "stream",
        "datatype": "utf8",
        "newline": "\\n",
        "topic": "",
        "trim": true,
        "base64": false,
        "x": 120,
        "y": 300,
        "wires": [["fn_receive_scanner"]]
    },
    {
        "id": "fn_receive_scanner",
        "type": "function",
        "name": "Receive Scanner Data",
        "func": "// ============================================\n// RECEIVE — Handle incoming scanner barcode\n// tcp in node listens on port 5000\n// ============================================\n\nconst raw      = msg.payload.toString().trim();\nconst socketId = msg._session ? msg._session.id : 'unknown';\nconst now      = new Date().toLocaleTimeString();\n\nmsg.payload = {\n    barcode:   raw,\n    source_ip: msg.ip || 'unknown',\n    socket_id: socketId,\n    timestamp: now\n};\n\nmsg.topic = 'devices/data/Scanner/scan_event';\n\nreturn msg;",
        "outputs": 1,
        "x": 360,
        "y": 300,
        "wires": [["mqtt_scan_event", "debug_scanner"]]
    },
    {
        "id": "mqtt_scan_event",
        "type": "mqtt out",
        "name": "MQTT Scan Event",
        "topic": "",
        "qos": "2",
        "retain": "false",
        "broker": "mqtt_broker",
        "x": 580,
        "y": 280,
        "wires": []
    },
    {
        "id": "debug_scanner",
        "type": "debug",
        "name": "Debug Scanner",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "x": 580,
        "y": 320,
        "wires": []
    },
    {
        "id": "inject_send_printer",
        "type": "inject",
        "name": "Test: Send to Printer",
        "props": [
            { "p": "payload" },
            { "p": "target", "v": "{\"name\":\"Printer_01\",\"ip\":\"192.168.1.10\",\"port\":9100,\"group\":\"Printer\"}", "vt": "json" },
            { "p": "data",   "v": "^XA^FO50,50^ADN,36,20^FDTest Print^FS^XZ", "vt": "str" }
        ],
        "once": false,
        "x": 120,
        "y": 440,
        "wires": [["fn_send_device"]]
    },
    {
        "id": "fn_send_device",
        "type": "function",
        "name": "Send Data to Device",
        "func": "// ============================================\n// SEND DATA — Prep message for tcp request\n// msg.target = { name, ip, port, group }\n// msg.data   = string to send\n// ============================================\n\nconst target = msg.target;\n\nmsg.host    = target.ip;\nmsg.port    = target.port;\nmsg._device = target;\n\n// Convert string to Buffer for TCP\nmsg.payload = Buffer.from(msg.data || '', 'utf8');\n\nreturn msg;",
        "outputs": 1,
        "x": 360,
        "y": 440,
        "wires": [["tcp_request_send"]]
    },
    {
        "id": "tcp_request_send",
        "type": "tcp request",
        "name": "TCP Send",
        "server": "",
        "port": "",
        "out": "time",
        "ret": "buffer",
        "splitc": "3000",
        "newline": "",
        "x": 560,
        "y": 440,
        "wires": [["fn_send_response"]]
    },
    {
        "id": "fn_send_response",
        "type": "function",
        "name": "Handle Send Response",
        "func": "// ============================================\n// SEND RESPONSE — Log ACK from device\n// Some devices (printers) may not reply\n// ============================================\n\nconst device = msg._device;\nconst now    = new Date().toLocaleTimeString();\n\nif (msg.payload && msg.payload.length > 0) {\n    msg.payload = {\n        device:    device.name,\n        response:  msg.payload.toString(),\n        status:    'ACK',\n        timestamp: now\n    };\n} else {\n    msg.payload = {\n        device:    device.name,\n        response:  'No response (normal for printers)',\n        status:    'SENT',\n        timestamp: now\n    };\n}\n\nmsg.topic = `devices/data/${device.group}/${device.name}`;\n\nreturn msg;",
        "outputs": 1,
        "x": 760,
        "y": 440,
        "wires": [["mqtt_send_response", "debug_send"]]
    },
    {
        "id": "mqtt_send_response",
        "type": "mqtt out",
        "name": "MQTT Send Response",
        "topic": "",
        "qos": "1",
        "retain": "false",
        "broker": "mqtt_broker",
        "x": 980,
        "y": 420,
        "wires": []
    },
    {
        "id": "debug_send",
